# .env de producción. En el servidor se copia como /opt/empre/.env (permisos 600) y se llena ahí.
# Nunca se sube a git. Lo leen docker compose (IMAGE, TAG, DOMAIN, ACME_EMAIL) y el backend (todo lo demás).

# --- Despliegue (lo usa docker compose) ---
IMAGE=gioleonp/empre-backend
# deploy.sh escribe aquí la versión desplegada (el sha del commit). El primer despliegue también lo pone él.
TAG=latest
# El dominio público del backend, sin https://. Con DuckDNS: tu-subdominio.duckdns.org
DOMAIN=empre-api.duckdns.org
# Correo al que Let's Encrypt avisa si un certificado está por vencer.
ACME_EMAIL=

# --- Backend ---
PORT=8080
APP_URL=https://empre-api.duckdns.org

# Base de datos (Supabase, Session pooler en el puerto 5432; nunca el Transaction pooler 6543).
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require

# Secreto largo y aleatorio: openssl rand -hex 32. En producción el backend no arranca con uno débil.
# Si cambia, todas las sesiones de la app se cierran.
JWT_SECRET=

# Protege /metrics. Otro valor aleatorio: openssl rand -hex 24
METRICS_TOKEN=

# Imágenes en S3 (bucket en us-east-2). En la EC2 van VACÍAS: el backend usa el rol de la máquina (permiso solo
# sobre el bucket, definido en deploy/aws/empre-api.yaml), así no hay llaves que robar. Solo se llenan en desarrollo.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-2

# IA (OpenCode Zen)
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=claude-haiku-5-5

# Wompi (suscripción de negocios). Llaves del ambiente que vayas a usar (sandbox o producción).
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=empre://subscription/result

# Correo (opcional). Sin SMTP_HOST, los correos de recuperación solo salen en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# Precios de la IA (USD por millón de tokens) para estimar el costo en GET /api/admin/ai-usage. Opcionales:
# por defecto los de Claude Haiku en OpenCode Zen.
# AI_PRICE_INPUT_PER_M=0.10
# AI_PRICE_OUTPUT_PER_M=0.50
# AI_PRICE_CACHE_READ_PER_M=0.01
# AI_PRICE_CACHE_WRITE_PER_M=0.125
# AI_PRICE_MARKUP=0.046

# Páginas legales (/privacidad y /eliminar-cuenta): correo de contacto y responsable de los datos.
LEGAL_CONTACT_EMAIL=soporte@empre.com.co
LEGAL_OWNER=Empre
