# Caddy recibe todo en 80/443, saca y renueva el certificado HTTPS del dominio y le pasa las peticiones al backend.
# El chat (websocket, /ws) pasa igual: reverse_proxy lo maneja sin configuración extra.

{
	email {$ACME_EMAIL}
}

# EXTRA_DOMAINS (opcional): otros nombres que también sirve, separados por espacio (p. ej. el sslip.io temporal).
{$DOMAIN} {$EXTRA_DOMAINS} {
	encode zstd gzip

	reverse_proxy api:8080 {
		# Si el backend se está reiniciando (un despliegue), espera unos segundos antes de responder con error.
		lb_try_duration 10s
	}

	# El chat manda el token de sesión en la URL (/api/chat/ws?token=...): se borra del log para que no quede
	# guardado donde cualquiera con acceso al servidor lo pueda leer. Authorization ya lo oculta Caddy solo.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
}
