PORT=8080

# Base de datos Postgres (con Supabase: usa el "Session pooler", puerto 5432.
# No uses el "Transaction pooler" (6543): el backend usa prepared statements).
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=tu_password
DB_NAME=postgres
DB_PORT=5432
# disable | require | verify-full  (con Supabase se recomienda "require")
DB_SSLMODE=require

# Genera uno largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# AWS S3 (imágenes)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Solo si usas credenciales temporales de AWS
S3_SESSION_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1

APP_URL=http://localhost:8080

# Correo (opcional). Sin SMTP_HOST, los correos de recuperación se imprimen en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# Asistente de IA para crear negocios (opcional). OpenCode Zen da acceso a
# varios modelos (Claude, GPT, Gemini...) con una sola API key:
# https://opencode.ai/zen — sin esta key, el asistente queda deshabilitado
# pero el resto de la app funciona igual.
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=claude-haiku-4-5


# Suscripción de negocios (pasarela Wompi, Colombia). Sacas las tres llaves
# del panel de Wompi (Comercio > API Keys): la pública y la de integridad son
# del ambiente sandbox o producción según en cuál estés probando; la de
# eventos es la que Wompi usa para firmar los webhooks. Sin
# WOMPI_PUBLIC_KEY/WOMPI_INTEGRITY_SECRET, la suscripción queda deshabilitada
# pero el resto de la app funciona igual.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Deep link al que Wompi redirige cuando el dueño termina de pagar en el
# widget (lo abre la app, no un navegador normal).
WOMPI_REDIRECT_URL=empre://subscription/result
