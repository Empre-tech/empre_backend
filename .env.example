PORT=8080

# Base de datos Postgres (con Supabase: usa el "Session pooler", puerto 5432.
# No uses el "Transaction pooler" (6543): el backend usa prepared statements).
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=tu_password
DB_NAME=postgres
DB_PORT=5432
# disable | require | verify-full  (con Supabase se recomienda "require")
DB_SSLMODE=require

# Genera uno largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# AWS S3 (imágenes)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Solo si usas credenciales temporales de AWS
S3_SESSION_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1

APP_URL=http://localhost:8080

# Correo (opcional). Sin SMTP_HOST, los correos de recuperación se imprimen en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=
